# Isi di Vercel Project Settings -> Environment Variables agar semua perangkat langsung terhubung
# tanpa perlu memasukkan ulang URL Web App maupun Token Rahasia:
APPS_SCRIPT_URL=
SECRET_TOKEN=

# Alias kompatibel (otomatis terdeteksi jika dipakai):
VITE_APPS_SCRIPT_URL=
VITE_APPS_SCRIPT_SECRET_TOKEN=