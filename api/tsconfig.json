{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "paths": {
      "@/*": ["../*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["./**/*", "../server/**/*"]
}
